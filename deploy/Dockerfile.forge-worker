# syntax=docker/dockerfile:1.7
# The Forge worker: Forge as a second engine for Yama's Lab runs (server/src/lab/forge.rs). Forge
# (https://github.com/Card-Forge/forge, GPL-3.0) runs as a separate program, one JVM per game; none of its
# code is in Yama. forge-worker/ is Yama's own HTTP front for the deck lab's batch runner
# (forge_runner.py, a copy of commander-decks scripts/sim/forge_runner.py). Private use.
#
# Built by deploy/deploy.sh with the context yama/forge-worker. Java 17, not 21: when one of Forge's AI
# decisions overruns its time and ignores the interrupt, Forge calls Thread.stop(), which Java 20+ refuses
# (see deploy/Dockerfile.forge and commander-decks docs/lab/forge.md).
#
# Read-only friendly: the worker writes only to /work (tmpfs: deck files and one Forge user dir per game) and
# /tmp (tmpfs, for the JVMs). Forge's card index is built here, at image build, into /opt/forge-index.
ARG JAVA_IMAGE=eclipse-temurin:17-jre
# Forge is Yama's own build (yama2, 2026-10-29: Card-Forge/forge master 3ead7e68 with AI speed fixes; notes in
# forge-worker/README.md), not a release download. The build is Forge code (GPL-3.0), so it stays out of Yama:
# forge-referee's dist/build-dist.sh makes the tarball (a release's layout: the desktop jar and res/), and
# deploy/forge-dist.sh installs it on saget as the local image yama-forge-dist:<FORGE_DIST>. The build refuses a
# tarball whose SHA-256 isn't this pin. Without the image the release build fails for all three services and
# production keeps running: install it before merging a new pin. Results carry the engine label
# "forge <version>", the version naming the Forge commit and the patch set (2.0.16-745401a4+yama2).
ARG FORGE_DIST=yama2
ARG FORGE_DIST_SHA256=5aca6b2e03f86bc578780464db20ada08e76cacfb59c357d531d1c5d3bee1bed
ARG FORGE_DIST_IMAGE=yama-forge-dist:${FORGE_DIST}

FROM ${FORGE_DIST_IMAGE} AS forgedist

FROM ${JAVA_IMAGE} AS forge
ARG FORGE_DIST_SHA256
COPY --from=forgedist /forge-dist.tar.gz /tmp/forge-dist.tar.gz
# One forge-<version> folder; /opt/forge/current points at it, so nothing else needs the version.
RUN echo "${FORGE_DIST_SHA256}  /tmp/forge-dist.tar.gz" | sha256sum -c - \
 && mkdir -p /opt/forge \
 && tar -xzf /tmp/forge-dist.tar.gz -C /opt/forge --no-same-owner --no-same-permissions \
 && rm /tmp/forge-dist.tar.gz \
 && test "$(ls -d /opt/forge/forge-* | wc -l)" = 1 \
 && ln -s "$(ls -d /opt/forge/forge-*)" /opt/forge/current \
 && test -f /opt/forge/current/res/cardsfolder/cardsfolder.zip \
 && ls /opt/forge/current/forge-gui-desktop-*-jar-with-dependencies.jar \
 && chmod -R a+rX /opt/forge

FROM ${JAVA_IMAGE}
# A passwd entry for uid 99 gives the JVM a real user.home (/work) instead of "?".
RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/* \
 && useradd -u 99 -g 100 -M -d /work -s /usr/sbin/nologin forge
COPY --from=forge /opt/forge /opt/forge
COPY common.py forge_runner.py worker.py /opt/forge-worker/
ENV FORGE_DIR=/opt/forge/current \
    FORGE_JAVA=/opt/java/openjdk/bin/java \
    FORGE_INDEX=/opt/forge-index \
    FORGE_WORK=/work \
    HOME=/work \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
# The card index (every name Forge's card scripts know), built once here so the worker starts at once.
RUN mkdir -p /opt/forge-index && python3 -c "import sys; sys.path.insert(0, '/opt/forge-worker'); \
import forge_runner as F; from pathlib import Path; F.CACHE = Path('/opt/forge-index'); \
print(len(F.card_index(F.Forge('${FORGE_DIR}', '${FORGE_JAVA}'))), 'card names')" \
 && chmod -R a+rX /opt/forge-index /opt/forge-worker
ARG FORGE_WORKER_GIT_SHA=
ENV FORGE_WORKER_GIT_SHA=${FORGE_WORKER_GIT_SHA}
USER 99:100
WORKDIR /work
EXPOSE 8791
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s \
  CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8791/health', timeout=4)" || exit 1
ENTRYPOINT ["python3", "/opt/forge-worker/worker.py"]
