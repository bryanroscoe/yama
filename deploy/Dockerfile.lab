# syntax=docker/dockerfile:1.7
# The simulation lab runner (play/src/bin/lab.rs) on its own, for batch runs on saget.
# Build from the repo root with the phase fork as a named context:
#   docker build -f deploy/Dockerfile.lab --build-context phase=../yama-phase -t yama-lab:latest .
# The target cache is shared with deploy/Dockerfile, so the engine crates usually come prebuilt.

FROM rust:1-bookworm AS build
WORKDIR /src/yama
COPY --from=phase Cargo.toml /src/yama-phase/Cargo.toml
COPY --from=phase crates /src/yama-phase/crates
COPY Cargo.toml Cargo.lock ./
COPY server server
COPY play play
# The runner stamp (play/build.rs): there is no .git here, so deploy/lab.sh passes the commit
# and whether the runner's sources differ from it.
ARG YAMA_LAB_GIT_SHA=
ARG YAMA_LAB_GIT_DIRTY=
ENV YAMA_LAB_GIT_SHA=$YAMA_LAB_GIT_SHA YAMA_LAB_GIT_DIRTY=$YAMA_LAB_GIT_DIRTY
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/yama/target \
    CARGO_BUILD_JOBS=4 cargo build --release -p yama-play --bin lab \
 && cp target/release/lab /usr/local/bin/lab

FROM debian:bookworm-slim
COPY --from=build /usr/local/bin/lab /usr/local/bin/lab
USER 99:100
ENTRYPOINT ["lab"]
