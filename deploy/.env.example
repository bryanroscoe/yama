# Where the deploy, lab and setup scripts reach saget. Fill in the real values in one of two
# places; never commit them:
#   ~/.config/yama/deploy.env   once per machine, read by every checkout and worktree (mode 600)
#   deploy/.env                 this checkout only (gitignored); wins over the machine's file
# Variables already set in the environment win over both. YAMA_DEPLOY_ENV names another machine
# file. deploy/target.sh and the polish tool read only these two keys.
YAMA_DEPLOY_HOST=saget.example.invalid
YAMA_DEPLOY_USER=root
