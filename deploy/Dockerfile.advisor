# syntax=docker/dockerfile:1.7
# Yama's advisor sidecar ("Ask Claude"): Node and the Claude Agent SDK, which brings its own
# Claude binary. It has no published port: only the yama container reaches it, on the private
# `yama_advisor` network (compose.yaml). Build from the repo root:
#   docker build -f deploy/Dockerfile.advisor -t yama-advisor:latest advisor
FROM node:22-bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY advisor.mjs server.mjs ./
# Claude writes its scratch files under HOME; each request gets its own directory under /tmp,
# which compose mounts as a tmpfs on an otherwise read-only filesystem.
ENV NODE_ENV=production HOME=/tmp ADVISOR_PORT=8790
USER node
EXPOSE 8790
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8790/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.mjs"]
