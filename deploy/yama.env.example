# Copy to /mnt/user/appdata/yama/yama.env on saget. Not in git.
YAMA_ADMIN_EMAILS=bryanroscoe@gmail.com
YAMA_SECURE_COOKIES=1
# Cloudflare Access in front of the whole hostname (recommended): its policy is the invite list.
YAMA_CF_ACCESS_TEAM=
YAMA_CF_ACCESS_AUD=
# Or Google sign-in (optional; needs an OAuth client for https://yama.ing)
# YAMA_GOOGLE_CLIENT_IDS=
# Let anyone with a verified Google account join (off unless 1). Needs the Google consent screen
# published (not Testing). Accounts without an invite get the smaller allowance. See deploy/README.md.
# YAMA_OPEN_SIGNUP=1
# Guest play (server/src/guests.rs): with open sign-up on, someone with no account may play the
# computer after a Cloudflare Turnstile check. Both needed; the widget is "Yama guest play".
# YAMA_TURNSTILE_SITE_KEY=
# YAMA_TURNSTILE_SECRET=
# The tunnel's Docker network, so per-address sign-in limits believe Cloudflare's CF-Connecting-IP.
# Find it: docker network inspect novalyst_default -f '{{range .IPAM.Config}}{{.Subnet}} {{end}}'
# YAMA_TRUSTED_PROXIES=172.18.0.0/16
# Password sign-in for accounts made with `yama-server user add` (on unless 0).
# YAMA_PASSWORD_LOGIN=0
# Lab caps: games waiting or playing for everyone but admins, the share for accounts without an
# invite, and games a day for each such account.
# YAMA_LAB_QUEUE_GAMES=2000
# YAMA_LAB_OPEN_QUEUE_GAMES=400
# YAMA_LAB_OPEN_DAILY_GAMES=300
# Never on a server anyone else can reach:
# YAMA_DEV_LOGIN=1
# Ask Claude (deploy/README.md, "Ask Claude"). deploy.sh writes these on saget the first time;
# don't copy them between servers. YAMA_ADVISOR_SUBSCRIPTION_EMAILS is the subscription owner only.
# YAMA_ADVISOR_URL=http://yama-advisor:8790
# YAMA_ADVISOR_SECRET=
# YAMA_ADVISOR_KEY_SECRET=
# The shared API key for granted accounts (the key itself is only in the sidecar's advisor.env;
# deploy/advisor-shared-key.sh). Defaults: $10 a calendar month for everyone together, Haiku only,
# and the granting admin's display name.
# YAMA_ADVISOR_SHARED_MONTHLY_USD=10
# YAMA_ADVISOR_SHARED_MODELS=claude-haiku-5-5
# YAMA_ADVISOR_SHARED_OWNER_NAME=Bryan
# Yama's tools for Ask Claude (server/src/mcp), reached by the sidecar on the advisor network:
# YAMA_ADVISOR_TOOLS_URL=http://yama:8787/mcp
# YAMA_ADVISOR_SUBSCRIPTION_EMAILS=bryanroscoe@gmail.com
# Claude's connectors sign in with OAuth (server/src/oauth). compose.yaml sets YAMA_PUBLIC_URL to
# https://yama.ing; the https hosts an app may send codes back to default to claude.ai,
# claude.com and chatgpt.com (Claude Code's loopback redirect is always allowed). Only change this to add a host:
# YAMA_OAUTH_REDIRECT_HOSTS=claude.ai,claude.com,chatgpt.com
# Forge as a second Lab engine (the yama-forge worker; deploy.sh adds both on saget).
# YAMA_FORGE_URL=http://yama-forge:8791
# YAMA_FORGE_SECRET=
# The Mythic Tools import (server/src/bridges/mythic): compose.yaml turns it on for saget; off
# unless 1 elsewhere. Mythic's API is private and may change; the bridge may be removed later.
# YAMA_MYTHIC_BRIDGE=1
