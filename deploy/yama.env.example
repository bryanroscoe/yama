# Copy to /mnt/user/appdata/yama/yama.env on saget. Not in git.
YAMA_ADMIN_EMAILS=bryanroscoe@gmail.com
YAMA_SECURE_COOKIES=1
# Cloudflare Access in front of the whole hostname (recommended): its policy is the invite list.
YAMA_CF_ACCESS_TEAM=
YAMA_CF_ACCESS_AUD=
# Or Google sign-in (optional; needs an OAuth client for https://yama.saget.org)
# YAMA_GOOGLE_CLIENT_IDS=
# Never on a server anyone else can reach:
# YAMA_DEV_LOGIN=1
