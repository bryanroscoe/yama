# Copy to .env (git-ignored). All optional except as noted.
# YAMA_DATA_DIR=data                      # SQLite DB and downloads
# YAMA_BIND=127.0.0.1:8787
# YAMA_WEB_DIST=web/dist                  # serve the built web app from the server
YAMA_ADMIN_EMAILS=bryan@example.com       # always allowed in; can invite others
# YAMA_GOOGLE_CLIENT_IDS=xxx.apps.googleusercontent.com,yyy.apps.googleusercontent.com
YAMA_DEV_LOGIN=1                          # email-only sign-in for local development; ignored unless YAMA_BIND is localhost.
                                          # Password accounts work anywhere: yama-server user add EMAIL [--admin]
# YAMA_SECURE_COOKIES=1                   # behind HTTPS
# YAMA_CORS_ORIGINS=capacitor://localhost,https://localhost   # the phone apps
# YAMA_AUTO_IMPORT=1                      # refresh Scryfall prices daily and rules weekly, and the release calendar
                                          # (Scryfall sets, MTGJSON precon lists) daily
# YAMA_DECK_CHECKS=0                      # don't send saved deck lists to Commander Spellbook for a bracket estimate and combos
# YAMA_AI_COMBOS=0                        # don't tell computer seats about the combos kept for the list they play (new games)
# YAMA_LAB_THREADS=1                      # isolated Phase games at once; 0 pauses them; each child has a 2 GiB heap limit
# YAMA_SLOW_REQUEST_MS=500                # requests slower than this are warnings in the log and listed in Admin, Server
# YAMA_SLOW_QUERY_MS=200                  # the same for SQL statements (deploy/README.md, "Finding slowness")
# YAMA_OFFLINE=1                          # reach no outside service: imports, deck checks, Forge, Google and Access sign-in off; previews, store checks,
                                          # Ask Claude, research, MTGJSON lists, the scanner's files and deck links answer
                                          # "unavailable offline" (scripts/dev-local.sh sets it for a prod copy)
# YAMA_OPEN_SIGNUP=1                      # anyone with a verified Google account may join; accounts without an invite get the
                                          # smaller allowance (deploy/README.md, "Open sign-up")
# YAMA_PASSWORD_LOGIN=0                   # turn off password sign-in (accounts from `yama-server user add`)
# YAMA_TRUSTED_PROXIES=172.18.0.0/16      # peers whose CF-Connecting-IP header is believed (the Cloudflare tunnel)
# YAMA_LAB_QUEUE_GAMES=2000               # lab games waiting or playing, everyone but admins together
# YAMA_LAB_OPEN_QUEUE_GAMES=400           # ...of which accounts without an invite together
# YAMA_LAB_OPEN_DAILY_GAMES=300           # games a day for each account without an invite
# YAMA_ADVISOR_URL=http://127.0.0.1:8790  # "Ask Claude": the advisor sidecar (advisor/; `ADVISOR_SECRET=... node server.mjs`)
# YAMA_ADVISOR_SECRET=                    # shared with the sidecar's ADVISOR_SECRET, at least 32 characters
# YAMA_ADVISOR_KEY_SECRET=                # encrypts people's own Anthropic API keys, at least 32 characters
# YAMA_FORGE_URL=http://127.0.0.1:8791    # Forge as a second Lab engine: the worker (`FORGE_SECRET=... python3 forge-worker/worker.py`)
# YAMA_FORGE_SECRET=                      # shared with the worker's FORGE_SECRET, at least 32 characters
# YAMA_ADVISOR_SUBSCRIPTION_EMAILS=       # accounts that ask on the sidecar's CLAUDE_CODE_OAUTH_TOKEN (its owner only)
# YAMA_ADVISOR_TOOLS_URL=http://127.0.0.1:8787/mcp  # lets Ask Claude use Yama's tools (server/src/mcp)
# YAMA_PUBLIC_URL=http://127.0.0.1:8787   # Yama's public address; turns on OAuth sign-in for Claude's connectors (server/src/oauth).
                                          # Locally, the address the browser uses (http://localhost:5173 under Vite)
# YAMA_OAUTH_REDIRECT_HOSTS=claude.ai,claude.com,chatgpt.com  # https hosts an OAuth app may send codes to (loopback is always allowed);
                                          # this is the default; set it empty for loopback only
