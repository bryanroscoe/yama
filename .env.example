# Copy to .env (git-ignored). All optional except as noted.
# YAMA_DATA_DIR=data                      # SQLite DB and downloads
# YAMA_BIND=127.0.0.1:8787
# YAMA_WEB_DIST=web/dist                  # serve the built web app from the server
YAMA_ADMIN_EMAILS=bryan@example.com       # always allowed in; can invite others
# YAMA_GOOGLE_CLIENT_IDS=xxx.apps.googleusercontent.com,yyy.apps.googleusercontent.com
YAMA_DEV_LOGIN=1                          # email-only sign-in for local development; ignored unless YAMA_BIND is localhost.
                                          # Password accounts work anywhere: yama-server user add EMAIL [--admin]
# YAMA_SECURE_COOKIES=1                   # behind HTTPS
# YAMA_CORS_ORIGINS=capacitor://localhost,https://localhost   # the phone apps
# YAMA_AUTO_IMPORT=1                      # refresh Scryfall prices daily and rules weekly
