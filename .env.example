# Copy to .env (git-ignored). All optional except as noted.
# YAMA_DATA_DIR=data                      # SQLite DB and downloads
# YAMA_BIND=127.0.0.1:8787
# YAMA_WEB_DIST=web/dist                  # serve the built web app from the server
YAMA_ADMIN_EMAILS=bryan@example.com       # always allowed in; can invite others
# YAMA_GOOGLE_CLIENT_IDS=xxx.apps.googleusercontent.com,yyy.apps.googleusercontent.com
YAMA_DEV_LOGIN=1                          # email-only sign-in for local development; ignored unless YAMA_BIND is localhost.
                                          # Password accounts work anywhere: yama-server user add EMAIL [--admin]
# YAMA_SECURE_COOKIES=1                   # behind HTTPS
# YAMA_CORS_ORIGINS=capacitor://localhost,https://localhost   # the phone apps
# YAMA_AUTO_IMPORT=1                      # refresh Scryfall prices daily and rules weekly, and the release calendar
                                          # (Scryfall sets, MTGJSON precon lists) daily
# YAMA_DECK_CHECKS=0                      # don't send saved deck lists to Commander Spellbook for a bracket estimate and combos
# YAMA_LAB_THREADS=2                      # game threads for lab experiments ("Try a change"); 0 turns them off
# YAMA_OPEN_SIGNUP=1                      # anyone with a verified Google account may join; accounts without an invite get the
                                          # smaller allowance (deploy/README.md, "Open sign-up")
# YAMA_PASSWORD_LOGIN=0                   # turn off password sign-in (accounts from `yama-server user add`)
# YAMA_TRUSTED_PROXIES=172.18.0.0/16      # peers whose CF-Connecting-IP header is believed (the Cloudflare tunnel)
# YAMA_LAB_QUEUE_GAMES=2000               # lab games waiting or playing, everyone but admins together
# YAMA_LAB_OPEN_QUEUE_GAMES=400           # ...of which accounts without an invite together
# YAMA_LAB_OPEN_DAILY_GAMES=300           # games a day for each account without an invite
