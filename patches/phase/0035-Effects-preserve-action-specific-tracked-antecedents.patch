--- a/crates/engine/src/game/effects/mod.rs
+++ b/crates/engine/src/game/effects/mod.rs
@@ -8630,6 +8630,27 @@ pub(crate) fn chain_references_tracked_set(ability: &ResolvedAbility) -> bool {
     branch_references_tracked_set(Some(ability))
 }
 
+/// CR 608.2c: a fresh action result may replace the chain's antecedent only
+/// when the following text reads that action (or an unqualified anaphor).
+/// A reader explicitly naming another action still needs the earlier binding.
+fn chain_references_tracked_set_for_cause(ability: &ResolvedAbility, cause: ThisWayCause) -> bool {
+    !crosses_modal_boundary(ability)
+        && node_or_branch_references_tracked_set(
+            ability,
+            ParentAnaphor::NamesPublisher,
+            Some(cause),
+        )
+}
+
+fn tracked_reader_accepts_cause(
+    reader: Option<ThisWayCause>,
+    producer: Option<ThisWayCause>,
+) -> bool {
+    // CR 608.2c: no producer restriction preserves the general dependency walk;
+    // no reader restriction names the fresh result of the current instruction.
+    producer.is_none_or(|producer| reader.is_none_or(|reader| reader == producer))
+}
