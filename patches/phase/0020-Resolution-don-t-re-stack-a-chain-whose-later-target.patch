From 4114c358d035eae604bfeec742458d239ad3b51c Mon Sep 17 00:00:00 2001
From: Bryan Roscoe <bryanroscoe@gmail.com>
Date: Sat, 24 Oct 2026 20:41:06 -0500
Subject: [PATCH 20/30] Resolution: don't re-stack a chain whose later target
 is already chosen
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Zaffai, Thunder Conductor: "Magecraft — Whenever you cast or copy an
instant or sorcery spell, scry 1. If that spell's mana value is 5 or
greater, create a 4/4 blue and red Elemental creature token. If that
spell's mana value is 10 or greater, Zaffai deals 10 damage to an
opponent chosen at random."

CR 603.3d + CR 608.2c: the trigger's instructions resolve in order, and
its targets were chosen when it was put on the stack. After the scry,
phase reached the token node (no target of its own, gated by the mana
value check) through try_materialize_reflexive_trigger. That built the
slots of the whole remaining chain, found the damage node's opponent,
and put the rest of the trigger back on the stack as a new ability
asking for that target. Resolving it did the same again, for ever: the
Elemental was never made, and no position repeated, so the loop detector
never fired (the lab's Prismari Performance games ended in action caps).

A node that is no "when you do" reflexive trigger now resolves in place
when a later node of its chain already holds its targets.

Not done here: with more than one opponent, the damage target "chosen at
random" is still chosen like an ordinary target when the trigger is put
on the stack, because the trigger's selection mode is read from its
first instruction.

Test: tests/integration/zaffai_thunder_conductor_magecraft.rs.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/engine/src/game/effects/mod.rs         | 13 +++
 crates/engine/tests/integration/main.rs       |  1 +
 .../zaffai_thunder_conductor_magecraft.rs     | 88 +++++++++++++++++++
 3 files changed, 102 insertions(+)
 create mode 100644 crates/engine/tests/integration/zaffai_thunder_conductor_magecraft.rs

diff --git a/crates/engine/src/game/effects/mod.rs b/crates/engine/src/game/effects/mod.rs
index 27e7725..1cbc37a 100644
--- a/crates/engine/src/game/effects/mod.rs
+++ b/crates/engine/src/game/effects/mod.rs
@@ -3731,6 +3731,19 @@ fn try_materialize_reflexive_trigger_inner(
     if !creates_reflexive_trigger && !reflexive.targets.is_empty() {
         return Ok(None);
     }
+    // CR 603.3d + CR 608.2c: an instruction that is no "when you do" reflexive
+    // trigger had its targets chosen with the ability it belongs to. When a
+    // later instruction of the chain already holds them (Zaffai, Thunder
+    // Conductor: "… create a 4/4 … Elemental … Zaffai deals 10 damage to an
+    // opponent chosen at random", where the token node declares no target and
+    // the damage node holds the opponent), the node resolves in place. Building
+    // the chain's slots here re-asked for that target as a new triggered
+    // ability, and resolving it did the same again, for ever.
+    if !creates_reflexive_trigger
+        && !crate::game::ability_utils::declared_targets_in_chain(reflexive).is_empty()
+    {
+        return Ok(None);
+    }
 
     // CR 608.2c + CR 603.12: The reflexive triggered ability is put on the
     // stack during the parent ability's resolution, so target legality must see
diff --git a/crates/engine/tests/integration/main.rs b/crates/engine/tests/integration/main.rs
index 5327c2e..b9f95eb 100644
--- a/crates/engine/tests/integration/main.rs
+++ b/crates/engine/tests/integration/main.rs
@@ -2030,3 +2030,4 @@ mod hashep_oasis_sacrifices_itself;
 mod lazotep_quarry_x_ability_with_tap;
 mod planar_nexus_every_nonbasic_land_type;
 mod jace_multiverse_architect_attack_restriction;
+mod zaffai_thunder_conductor_magecraft;
diff --git a/crates/engine/tests/integration/zaffai_thunder_conductor_magecraft.rs b/crates/engine/tests/integration/zaffai_thunder_conductor_magecraft.rs
new file mode 100644
index 0000000..f03a536
--- /dev/null
+++ b/crates/engine/tests/integration/zaffai_thunder_conductor_magecraft.rs
@@ -0,0 +1,88 @@
+//! Zaffai, Thunder Conductor — "Magecraft — Whenever you cast or copy an
+//! instant or sorcery spell, scry 1. If that spell's mana value is 5 or
+//! greater, create a 4/4 blue and red Elemental creature token. If that
+//! spell's mana value is 10 or greater, Zaffai deals 10 damage to an opponent
+//! chosen at random."
+//!
+//! CR 603.3d + CR 608.2c: the trigger's instructions resolve in order. Before
+//! the fix, once the scry was answered, the rest of the chain (the token node,
+//! whose later damage node holds the opponent) was put back on the stack as a
+//! new triggered ability asking for that target, and resolving it did the same
+//! again, for ever: the Elemental was never made and games hit the action cap.
+
+use engine::ai_support::AiDecisionContract;
+use engine::game::scenario::{GameRunner, GameScenario, P0};
+use engine::types::actions::GameAction;
+use engine::types::game_state::{CastPaymentMode, WaitingFor};
+use engine::types::mana::{ManaColor, ManaCost};
+use engine::types::phase::Phase;
+use engine::types::zones::Zone;
+
+/// Verbatim Oracle text (MTGJSON).
+const ZAFFAI: &str = "Magecraft \u{2014} Whenever you cast or copy an instant or sorcery spell, scry 1. If that spell's mana value is 5 or greater, create a 4/4 blue and red Elemental creature token. If that spell's mana value is 10 or greater, Zaffai deals 10 damage to an opponent chosen at random.";
+
+/// Answer every decision with the engine's first offer until the stack is
+/// empty; `None` if it never settles.
+fn settle(runner: &mut GameRunner) -> Option<usize> {
+    for step in 0..80 {
+        if matches!(runner.state().waiting_for, WaitingFor::Priority { .. })
+            && runner.state().stack.is_empty()
+        {
+            return Some(step);
+        }
+        let player = runner.state().waiting_for.acting_players()[0];
+        let action = AiDecisionContract::issue(runner.state(), player)
+            .candidates
+            .into_iter()
+            .map(|candidate| candidate.action)
+            .find(|action| !matches!(action, GameAction::CancelCast))
+            .expect("the engine offers an answer");
+        runner
+            .act(action.clone())
+            .unwrap_or_else(|e| panic!("{action:?} refused: {e}"));
+    }
+    None
+}
+
+#[test]
+fn zaffai_makes_the_elemental_for_a_five_mana_sorcery_and_settles() {
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::PreCombatMain);
+    scenario.add_creature_from_oracle(P0, "Zaffai, Thunder Conductor", 1, 4, ZAFFAI);
+    for _ in 0..5 {
+        scenario.add_basic_land(P0, ManaColor::Blue);
+    }
+    for name in ["Island", "Island", "Island"] {
+        scenario.add_card_to_library_top(P0, name);
+    }
+    let spell = scenario
+        .add_spell_to_hand_from_oracle(P0, "Big Sorcery", false, "Draw a card.")
+        .with_mana_cost(ManaCost::generic(5))
+        .id();
+    let mut runner = scenario.build();
+    let card_id = runner.state().objects[&spell].card_id;
+    runner
+        .act(GameAction::CastSpell {
+            object_id: spell,
+            card_id,
+            targets: vec![],
+            payment_mode: CastPaymentMode::Auto,
+        })
+        .expect("cast the sorcery");
+
+    assert!(
+        settle(&mut runner).is_some(),
+        "the magecraft trigger and the spell resolve and the game settles"
+    );
+    let elementals = runner
+        .state()
+        .battlefield
+        .iter()
+        .filter(|id| {
+            let o = &runner.state().objects[*id];
+            o.is_token && o.card_types.subtypes.iter().any(|s| s == "Elemental")
+        })
+        .count();
+    assert_eq!(elementals, 1, "one 4/4 Elemental for a five-mana spell");
+    assert_eq!(runner.state().objects[&spell].zone, Zone::Graveyard);
+}
