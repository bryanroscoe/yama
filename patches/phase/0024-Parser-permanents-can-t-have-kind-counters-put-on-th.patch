+++ b/crates/engine/src/parser/oracle_replacement.rs
@@ -778,6 +778,9 @@ fn parse_replacement_line_inner(text: &str, card_name: &str) -> Option<Replaceme
     if let Some(def) = parse_inverted_typed_counter_prohibition(&lower, &text) {
         return Some(def);
