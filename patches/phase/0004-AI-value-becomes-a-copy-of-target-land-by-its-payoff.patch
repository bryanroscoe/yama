+        // Stage as a copy of Dark Depths) over the original that still has
+        // its counters; otherwise lands tie.
+        return 3.0 + zero_counter_state_trigger_payoff(object, object);
     }
 
     (object.mana_cost.mana_value() as f64).min(6.0)
