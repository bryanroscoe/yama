From f076a28ad10711d3474306a792170bc97e8ab89f Mon Sep 17 00:00:00 2001
From: Bryan Roscoe <bryanroscoe@gmail.com>
Date: Sat, 24 Oct 2026 21:05:04 -0500
Subject: [PATCH 25/30] Conditions: "if you're the monarch" for activation
 costs and restrictions

Crown of Gondor: "Equip {4}. This ability costs {3} less to activate if
you're the monarch."

CR 725.1 + CR 601.2f + CR 602.2b: the conditional flat cost reduction
already exists (Esquire of the King), but its condition is a
ParsedCondition, which had no monarch leaf, so "if you're the monarch"
didn't parse and the clause was swallowed: equip always cost {4}.

New ParsedCondition::IsMonarch, mapped from StaticCondition::IsMonarch
for the controller and evaluated as "the evaluating player is the
monarch"; handled in the exhaustive matches (casting, ai_support).

Test: oracle_cost tests cost_reduction_if_you_are_the_monarch.

Card data: reaches games only with card data generated by this parser.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/engine/src/ai_support/filter.rs       |  3 +++
 crates/engine/src/game/casting.rs            |  1 +
 crates/engine/src/game/restrictions.rs       |  2 ++
 crates/engine/src/parser/oracle_condition.rs |  6 ++++++
 crates/engine/src/parser/oracle_cost.rs      | 13 +++++++++++++
 crates/engine/src/types/ability.rs           |  4 ++++
 6 files changed, 29 insertions(+)

diff --git a/crates/engine/src/ai_support/filter.rs b/crates/engine/src/ai_support/filter.rs
index 489d200..26b8563 100644
--- a/crates/engine/src/ai_support/filter.rs
+++ b/crates/engine/src/ai_support/filter.rs
@@ -1120,6 +1120,9 @@ fn condition_reads_only_memo_safe_state(c: &ParsedCondition) -> bool {
         // designation predicates above and `ControlsCommander` below. No combat,
         // damage, or pending-cast history.
         | ParsedCondition::HasMaxSpeed
+        // CR 725.1: the monarch designation, read off state like the
+        // designations above.
+        | ParsedCondition::IsMonarch
         // CR 903.3 / CR 903.3d: a controller-scoped battlefield scan for a commander
         // (via `game::commander`), like the other `YouControl*` predicates — reads no
         // combat/damage/pending-cast history, so it is memo-safe.
diff --git a/crates/engine/src/game/casting.rs b/crates/engine/src/game/casting.rs
index 4291d9e..9b917b1 100644
--- a/crates/engine/src/game/casting.rs
+++ b/crates/engine/src/game/casting.rs
@@ -28900,6 +28900,7 @@ fn parsed_condition_reads_targets(condition: &ParsedCondition, read: TargetRead)
         | ParsedCondition::HasEnduringStory
         | ParsedCondition::CompletedDungeon { .. }
         | ParsedCondition::HasMaxSpeed
+        | ParsedCondition::IsMonarch
         | ParsedCondition::IsYourTurn
         | ParsedCondition::IsOpponentsTurn
         | ParsedCondition::IsDuringUpkeep
diff --git a/crates/engine/src/game/restrictions.rs b/crates/engine/src/game/restrictions.rs
index f526002..88ae3a4 100644
--- a/crates/engine/src/game/restrictions.rs
+++ b/crates/engine/src/game/restrictions.rs
@@ -1812,6 +1812,8 @@ fn evaluate_condition_for_granter(
         // ("a player has max speed if their speed is 4") and the CR 101.1
         // card-over-rule override that lets a static raise that cap (Gomif) read
         // identically whether a card gates a static ability or an activation.
+        // CR 725.1: the player the condition is evaluated for is the monarch.
+        ParsedCondition::IsMonarch => state.monarch == Some(player),
         ParsedCondition::HasMaxSpeed => state.objects.get(&source_id).is_some_and(|object| {
             let whose_speed = if object.zone == Zone::Battlefield {
                 object.controller
diff --git a/crates/engine/src/parser/oracle_condition.rs b/crates/engine/src/parser/oracle_condition.rs
index 4b4833f..52f0262 100644
--- a/crates/engine/src/parser/oracle_condition.rs
+++ b/crates/engine/src/parser/oracle_condition.rs
@@ -304,6 +304,12 @@ fn static_condition_to_restriction_condition(
         // `game::speed::has_max_speed`, so the restriction cannot drift from the
         // static one this condition also feeds.
         StaticCondition::HasMaxSpeed => Some(ParsedCondition::HasMaxSpeed),
+        // CR 725.1: "you're the monarch" — a designation read off the scoped
+        // player, like the leaves above. Other players' monarchy (a defending
+        // player's) has no restriction evaluator and stays declined below.
+        StaticCondition::IsMonarch {
+            player: crate::types::ability::PlayerScope::Controller,
+        } => Some(ParsedCondition::IsMonarch),
         // CR 702.195b: The enduring story designation is available to restrictions.
         StaticCondition::HasEnduringStory => Some(ParsedCondition::HasEnduringStory),
         // CR 309.7 + CR 602.5b: dungeon completion is a player-status leaf of the
diff --git a/crates/engine/src/parser/oracle_cost.rs b/crates/engine/src/parser/oracle_cost.rs
index 3b7271b..d1722c2 100644
--- a/crates/engine/src/parser/oracle_cost.rs
+++ b/crates/engine/src/parser/oracle_cost.rs
@@ -4471,6 +4471,19 @@ mod tests {
         assert_eq!(two.amount_per, 2);
     }
 
+    /// CR 725.1 + CR 601.2f: Crown of Gondor — "This ability costs {3} less to
+    /// activate if you're the monarch." gates on the monarch designation.
+    #[test]
+    fn cost_reduction_if_you_are_the_monarch() {
+        use crate::types::ability::ParsedCondition;
+        let r = try_parse_cost_reduction(
+            "this ability costs {3} less to activate if you're the monarch",
+        )
+        .expect("must parse");
+        assert_eq!(r.amount_per, 3);
+        assert_eq!(r.condition, Some(ParsedCondition::IsMonarch));
+    }
+
     /// CR 508.1a + CR 601.2f: the conditional flat form gated by "you attacked
     /// with a <filter>" extracts a filtered `AttackedThisTurn` quantity gate
     /// (GE 1). The trailing "this turn" is stripped upstream as a duration
diff --git a/crates/engine/src/types/ability.rs b/crates/engine/src/types/ability.rs
index 6f0563f..6b8c8f9 100644
--- a/crates/engine/src/types/ability.rs
+++ b/crates/engine/src/types/ability.rs
@@ -14151,6 +14151,10 @@ pub enum ParsedCondition {
     /// speed-is-4 test and the CR 101.1 card-over-rule override that raises that
     /// cap cannot diverge between the static and restriction readings.
     HasMaxSpeed,
+    /// CR 725.1: "if you're the monarch" — the evaluating player holds the
+    /// monarch designation (Crown of Gondor: "Equip {4}. This ability costs {3}
+    /// less to activate if you're the monarch.").
+    IsMonarch,
     /// CR 102.1: "The active player is the player whose turn it is." True when
     /// the scoped player is the active player — gates a casting/restriction
     /// predicate on "if it's your turn". For "if it's not your turn" the parser
