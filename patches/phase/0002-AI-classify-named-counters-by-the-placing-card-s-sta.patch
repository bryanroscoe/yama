             EffectPolarity::Harmful => -1.0,
             EffectPolarity::Contextual => 0.0,
@@ -1973,6 +2108,12 @@ pub(crate) fn modification_polarity(m: &ContinuousModification) -> EffectPolarit
         | ContinuousModification::AddKeywordWithDerivedCost { .. }
         | ContinuousModification::GrantAbility { .. }
         | ContinuousModification::AddAllCreatureTypes
+        // CR 305.6 + CR 305.7 + CR 205.3i: gaining land types "in addition to
