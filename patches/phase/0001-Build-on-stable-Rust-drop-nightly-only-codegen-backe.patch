From 572c2b022168746867d2f23e00fdea728f4de7c7 Mon Sep 17 00:00:00 2001
From: Bryan Roscoe <bryanroscoe@gmail.com>
Date: Sun, 18 Oct 2026 15:35:34 -0500
Subject: [PATCH] Build on stable Rust: drop nightly-only codegen-backend
 manifest settings

Local Yama fork of phase v0.113.0. The code itself needs no nightly features.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Cargo.toml | 3 ---
 1 file changed, 3 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index 8c0096f..50cebd8 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -1,4 +1,3 @@
-cargo-features = ["codegen-backend"]
 
 [workspace]
 resolver = "2"
@@ -77,7 +76,6 @@ codegen-units = 256
 [profile.wasm-dev]
 inherits = "dev"
 opt-level = 2
-codegen-backend = "llvm"
 
 [profile.release]
 opt-level = 'z'
@@ -103,7 +101,6 @@ panic = 'unwind'
 [profile.tool]
 inherits = "dev"
 opt-level = 1
-codegen-backend = "llvm"
 
 # Profiling: native-optimized like server-release, with debug info retained
 # so samply/flamegraph attribute samples to real symbols.
-- 
2.53.0

