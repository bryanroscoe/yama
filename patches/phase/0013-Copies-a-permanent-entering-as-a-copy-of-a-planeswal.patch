From 7417c9d9b4581d4ce9948c2d21ec190c293648ac Mon Sep 17 00:00:00 2001
From: Bryan Roscoe <bryanroscoe@gmail.com>
Date: Sat, 24 Oct 2026 20:25:27 -0500
Subject: [PATCH 13/30] Copies: a permanent entering as a copy of a
 planeswalker gets its loyalty

Spark Double: "You may have this creature enter as a copy of a creature
or planeswalker you control, except it enters with an additional +1/+1
counter on it if it's a creature, it enters with an additional loyalty
counter on it if it's a planeswalker, and it isn't legendary." Ruling:
copying a planeswalker, it enters with the copied printed loyalty plus
one.

CR 306.5b: a planeswalker enters with loyalty counters equal to its
printed loyalty (CR 310.4b: a battle, defense counters). CR 614.12 +
CR 707.9: whether the permanent is a planeswalker, and with what loyalty,
is decided with the "enters as a copy" replacement already applied.

phase seeded the intrinsic counters on the move from the spell's own
characteristics (Spark Double: none), before the copy choice, so the copy
of Jace, Multiverse Architect entered with 1 loyalty counter instead of
5. finish_copy_target_choice_entry now adds what the copied values call
for beyond what the move seeded, ahead of the copy's own extra counter,
through the same counter-placement path (so Doubling Season and the like
still apply). Tokens and melds seed these counters on their own entry
paths and are unchanged.

Test: spark_double_as_enters.rs,
spark_double_copying_a_planeswalker_enters_with_its_loyalty_plus_one.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/engine/src/game/engine_replacement.rs  | 64 +++++++++++++++++--
 .../integration/spark_double_as_enters.rs     | 59 +++++++++++++++++
 2 files changed, 118 insertions(+), 5 deletions(-)

diff --git a/crates/engine/src/game/engine_replacement.rs b/crates/engine/src/game/engine_replacement.rs
index fdcce54..c270fc6 100644
--- a/crates/engine/src/game/engine_replacement.rs
+++ b/crates/engine/src/game/engine_replacement.rs
@@ -2352,7 +2352,14 @@ pub(super) fn handle_copy_target_choice(
                 context: context.clone(),
             }];
             if let Some(waiting_for) =
-                finish_copy_target_choice_entry(state, source_id, events, post_actions, false)?
+                finish_copy_target_choice_entry(
+                    state,
+                    source_id,
+                    events,
+                    post_actions,
+                    false,
+                    None,
+                )?
             {
                 if state.active_counter_additions().is_none() {
                     crate::game::meld::finish_deferred_meld_entry(state, context, events);
@@ -2488,6 +2495,7 @@ pub(super) fn handle_copy_target_choice(
             events,
             counter_pause_post_actions,
             true,
+            None,
         )? {
             return Ok(waiting_for);
         }
@@ -2531,6 +2539,15 @@ pub(super) fn handle_copy_target_choice(
         });
     }
 
+    // CR 306.5b + CR 310.4b: the intrinsic loyalty or defense counters this
+    // permanent was given as it moved, read from its own characteristics
+    // before the copy (`finish_copy_target_choice_entry` tops them up to the
+    // copied values).
+    let pre_copy_intrinsic = state
+        .objects
+        .get(&source_id)
+        .map(|obj| crate::game::printed_cards::intrinsic_etb_counters(obj, None))
+        .unwrap_or_default();
     let ability = copy_effect_for_source(state, source_id)
         .map(|effect_def| {
             build_resolved_from_def_with_targets(
@@ -2572,9 +2589,14 @@ pub(super) fn handle_copy_target_choice(
             .expect("matching spell-resolution frame was checked above");
         apply_pending_spell_resolution(state, &ctx, events);
     }
-    if let Some(waiting_for) =
-        finish_copy_target_choice_entry(state, source_id, events, Vec::new(), true)?
-    {
+    if let Some(waiting_for) = finish_copy_target_choice_entry(
+        state,
+        source_id,
+        events,
+        Vec::new(),
+        true,
+        Some(&pre_copy_intrinsic),
+    )? {
         return Ok(waiting_for);
     }
     state.waiting_for = WaitingFor::Priority {
@@ -2584,19 +2606,50 @@ pub(super) fn handle_copy_target_choice(
     Ok(state.waiting_for.clone())
 }
 
+/// `pre_copy_intrinsic` is the intrinsic loyalty and defense counters the
+/// permanent was given as it moved, from its pre-copy characteristics, when
+/// the caller seeded them that way (a resolving permanent spell); `None` where
+/// the entry path seeds them itself (tokens and melds).
 fn finish_copy_target_choice_entry(
     state: &mut GameState,
     source_id: ObjectId,
     events: &mut Vec<GameEvent>,
     counter_pause_post_actions: Vec<PendingCounterPostAction>,
     replay_entry_events: bool,
+    pre_copy_intrinsic: Option<&[(CounterType, u32)]>,
 ) -> Result<Option<WaitingFor>, EngineError> {
     // Force a full layer pass after the copy chain so the realized
     // characteristics below (enter-tapped, ETB counters) read post-copy state.
     crate::game::layers::mark_layers_full(state);
     crate::game::layers::flush_layers(state);
-    let enter_modifiers =
+    let mut enter_modifiers =
         super::replacement::current_self_enter_replacement_modifiers(state, source_id);
+    // CR 306.5b + CR 310.4b + CR 614.12: a planeswalker enters with loyalty
+    // counters equal to its printed loyalty (a battle, defense counters), and
+    // whether it is a planeswalker, and with what loyalty, is decided with the
+    // "enters as a copy" replacement already applied (CR 614.12, CR 707.9).
+    // The move seeded these counters from the pre-copy characteristics, so add
+    // what the copied values call for beyond them: Spark Double copying Jace,
+    // Multiverse Architect enters with four plus its own extra one, not one.
+    if let Some(pre) = pre_copy_intrinsic {
+        let post = state
+            .objects
+            .get(&source_id)
+            .map(|obj| crate::game::printed_cards::intrinsic_etb_counters(obj, None))
+            .unwrap_or_default();
+        let missing: Vec<(CounterType, u32)> = post
+            .into_iter()
+            .filter_map(|(counter_type, count)| {
+                let seeded: u32 = pre
+                    .iter()
+                    .filter(|(seeded_type, _)| *seeded_type == counter_type)
+                    .map(|(_, n)| *n)
+                    .sum();
+                (count > seeded).then(|| (counter_type, count - seeded))
+            })
+            .collect();
+        enter_modifiers.counters.splice(0..0, missing);
+    }
     if let Some(tapped) = enter_modifiers.enter_tapped {
         if let Some(obj) = state.objects.get_mut(&source_id) {
             obj.tapped = tapped;
@@ -8105,6 +8158,7 @@ mod tests {
             &mut events,
             vec![continuation],
             false,
+            None,
         )
         .expect("the host pause is not an error");
 
diff --git a/crates/engine/tests/integration/spark_double_as_enters.rs b/crates/engine/tests/integration/spark_double_as_enters.rs
index c33c7c5..cef3d59 100644
--- a/crates/engine/tests/integration/spark_double_as_enters.rs
+++ b/crates/engine/tests/integration/spark_double_as_enters.rs
@@ -89,3 +89,62 @@ fn spark_double_copying_painters_servant_keeps_its_counter_and_prompts_for_color
         WaitingFor::Priority { .. }
     ));
 }
+
+/// Jace, Multiverse Architect's verbatim Oracle text (MTGJSON), printed loyalty 4.
+const JACE: &str = "At the beginning of combat on each opponent's turn, they may pay {2}. If they don't, creatures they control can't attack Jaces you control this turn.\n[+1]: Draw two cards, then put a card from your hand on the bottom of your library.\n[\u{2212}3]: Exile another target planeswalker or creature you control. Reveal cards from the top of your library until you reveal a creature or planeswalker card. Put that card onto the battlefield and the rest on the bottom of your library in a random order.\nJace, Multiverse Architect can be your commander.";
+
+/// CR 306.5b + CR 614.12 + CR 707.9: whether a permanent is a planeswalker,
+/// and so how many loyalty counters it enters with, is decided with the
+/// "enters as a copy" replacement already applied. Spark Double copying a
+/// planeswalker therefore enters with the copied printed loyalty plus its own
+/// additional counter (the card's ruling: "it enters with loyalty counters
+/// equal to the copied planeswalker's printed loyalty plus one"), and the
+/// copy isn't legendary, so the legend rule leaves both on the battlefield.
+#[test]
+fn spark_double_copying_a_planeswalker_enters_with_its_loyalty_plus_one() {
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::PreCombatMain);
+    let jace = scenario
+        .add_planeswalker_from_oracle(P0, "Jace, Multiverse Architect", "Jace", 4, JACE)
+        .id();
+    let spark = scenario
+        .add_creature_to_hand_from_oracle(P0, "Spark Double", 0, 0, SPARK_DOUBLE)
+        .id();
+    let mut runner = scenario.build();
+    // The builder places the planeswalker with its counters but no printed
+    // loyalty (a face built from Oracle text alone carries none); real card
+    // data has it, and the copy reads it (CR 707.2).
+    if let Some(obj) = runner.state_mut().objects.get_mut(&jace) {
+        obj.printed_loyalty = Some(engine::types::card::PrintedLoyalty::Fixed(4));
+        obj.base_printed_loyalty = obj.printed_loyalty;
+    }
+    let card_id = runner.state().objects[&spark].card_id;
+
+    runner
+        .act(GameAction::CastSpell {
+            object_id: spark,
+            card_id,
+            targets: vec![],
+            payment_mode: CastPaymentMode::Auto,
+        })
+        .expect("cast Spark Double");
+    runner.advance_until_stack_empty();
+    runner
+        .act(GameAction::ChooseReplacement { index: 0 })
+        .expect("accept Spark Double's copy replacement");
+    runner
+        .act(GameAction::ChooseTarget {
+            target: Some(TargetRef::Object(jace)),
+        })
+        .expect("copy Jace");
+    runner.advance_until_stack_empty();
+
+    let copy = &runner.state().objects[&spark];
+    assert_eq!(copy.zone, Zone::Battlefield, "the copy stays: it isn't legendary");
+    assert_eq!(
+        copy.counters.get(&CounterType::Loyalty).copied(),
+        Some(5),
+        "four copied loyalty plus Spark Double's one"
+    );
+    assert_eq!(runner.state().objects[&jace].zone, Zone::Battlefield);
+}
