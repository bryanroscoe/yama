From 2eee4c5f8a8a603bae17ea1f839d613e14c13c75 Mon Sep 17 00:00:00 2001
From: Bryan Roscoe <bryanroscoe@gmail.com>
Date: Sat, 24 Oct 2026 22:32:37 -0500
Subject: [PATCH 29/30] Parser: an animation's "where X is" takes any where-X
 expression

Sage of the Maze: "{T}: Until end of turn, target land you control
becomes an X/X Citizen creature with haste in addition to its other
types, where X is twice the number of Gates you control. Activate only
as a sorcery."

CR 107.3c + CR 208.3: the animation parser read the where-X clause with
the bare quantity-reference grammar only, so "twice the number of Gates
you control" failed and the whole ability stayed unimplemented
(unparsed_verb_arguments). A bare reference keeps its old path; any
other where-X expression now goes through the shared where-X quantity
grammar (parse_where_x_quantity_expression), which owns multipliers and
arithmetic. With one Gate, Sage makes the land a 2/2 Citizen with haste.

Card data: the parse change reaches games only with card data generated
by this parser.

Test: parser/oracle_effect/animation.rs
animation_where_x_accepts_a_multiplied_count.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../src/parser/oracle_effect/animation.rs     | 34 +++++++++++++++++--
 1 file changed, 32 insertions(+), 2 deletions(-)

diff --git a/crates/engine/src/parser/oracle_effect/animation.rs b/crates/engine/src/parser/oracle_effect/animation.rs
index 1f3944d..a10ca49 100644
--- a/crates/engine/src/parser/oracle_effect/animation.rs
+++ b/crates/engine/src/parser/oracle_effect/animation.rs
@@ -77,8 +77,14 @@ pub(crate) fn parse_animation_spec(text: &str, _ctx: &mut ParseContext) -> Optio
         let after_where_lower = after_where.to_lowercase();
         rest = parse_cost_x_become_pt_prefix(before_where).unwrap_or(before_where);
 
-        let (_, qty) = nom_quantity::parse_quantity_ref_complete(&after_where_lower).ok()?;
-        let dynamic_qty = QuantityExpr::Ref { qty };
+        // CR 107.3c + CR 208.3: a bare count ("~'s power") is a plain
+        // reference; any other where-X expression ("twice the number of Gates
+        // you control", Sage of the Maze) goes through the shared where-X
+        // quantity grammar, which owns multipliers and arithmetic.
+        let dynamic_qty = match nom_quantity::parse_quantity_ref_complete(&after_where_lower) {
+            Ok((_, qty)) => QuantityExpr::Ref { qty },
+            Err(_) => super::lower::parse_where_x_quantity_expression(after_where)?,
+        };
         spec.dynamic_power = Some(dynamic_qty.clone());
         spec.dynamic_toughness = Some(dynamic_qty);
     }
@@ -1155,6 +1161,30 @@ mod test_den_bugbear {
         ));
     }
 
+    /// CR 107.3c + CR 205.1b: Sage of the Maze's "target land you control
+    /// becomes an X/X Citizen creature with haste in addition to its other
+    /// types, where X is twice the number of Gates you control".
+    #[test]
+    fn animation_where_x_accepts_a_multiplied_count() {
+        let spec = parse_animation_spec(
+            "an X/X Citizen creature with haste in addition to its other types, where X is twice the number of Gates you control",
+            &mut ParseContext::default(),
+        )
+        .expect("Sage of the Maze's animation must parse");
+        assert!(
+            matches!(
+                spec.dynamic_power,
+                Some(QuantityExpr::Multiply { factor: 2, .. })
+            ),
+            "{:?}",
+            spec.dynamic_power
+        );
+        assert_eq!(spec.dynamic_power, spec.dynamic_toughness);
+        assert!(spec.keywords.contains(&Keyword::Haste));
+        assert!(spec.types.iter().any(|t| t == "Citizen"));
+        assert!(spec.types.iter().any(|t| t == "Creature"));
+    }
+
