 crates/engine/src/game/casting_costs.rs       | 24 +++++
 .../hashep_oasis_sacrifices_itself.rs         | 93 +++++++++++++++++++
 crates/engine/tests/integration/main.rs       |  1 +
 3 files changed, 118 insertions(+)
