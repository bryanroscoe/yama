@@ -1588,6 +1652,16 @@ fn whole_attack_proposal(
 ) -> Option<WholeAttack> {
     let mut work = 0usize;
     let total = |w: &WholeAttack| w.pre_finish_utility + if w.finishes { 2.0 } else { 0.0 };
+    // Candidates come smallest attack first. Ties keep the smaller attack,
+    // except between attacks that kill the defender, where the larger one keeps
+    // a margin against a miscounted block (damage past lethal scores nothing).
+    let better = |candidate: &WholeAttack, best: Option<&WholeAttack>| {
+        let best_total = best.map_or(0.0, total);
